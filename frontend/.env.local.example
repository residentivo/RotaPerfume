# URL base da API Go (padrao: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Site key publica do Cloudflare Turnstile (CAPTCHA), usada nas telas de
# Login e Trocar Senha. E publica (nao e segredo) — a secret key correspondente
# fica somente no backend, nunca aqui. Obter em https://dash.cloudflare.com/ > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Log verbose de rastreamento no console do navegador (LOG-02), formato
# "[arquivo] [funcao] descricao". E embutido no bundle em tempo de build:
# mantenha "false" (ou ausente) em producao. Use "true" apenas em dev.
NEXT_PUBLIC_VERBOSE=false
