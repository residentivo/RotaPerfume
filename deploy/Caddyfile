# Proxy reverso unico do rotaperfumes (unica porta publicada no host).
#
# - HTTPS com CA interna do Caddy (tls internal): o navegador mostra aviso de
#   certificado ate a raiz da CA ser instalada nos clientes. A raiz fica no
#   volume caddy_data: /data/caddy/pki/authorities/local/root.crt
# - Certificados para localhost, 127.0.0.1, {$SITE_HOST} e {$SITE_IP}.
#   Navegadores nao mandam SNI para IP, por isso default_sni aponta para o IP.
# - Qualquer outro Host (ex.: dominio publico do Cloudflare Tunnel) cai no
#   site curinga "https://" com as mesmas rotas. O cloudflared roda no
#   servidor e aponta para a porta ${HTTPS_PORT} (noTLSVerify, CA interna).
# - As rotas da API ja comecam com /api/... -> "handle" (SEM strip do prefixo).
# - Dentro do container o Caddy escuta 443; o host publica ${HTTPS_PORT}:443.
#   O matcher de host ignora a porta do header Host, entao host:8443 casa.
{
	default_sni {$SITE_IP}
	skip_install_trust
	auto_https disable_redirects
	servers {
		protocols h1 h2
		# Conexoes vindas do proprio servidor: pelo IP da LAN ({$SITE_IP}, como o
		# cloudflared acessa hoje) ou pelo gateway da rede docker (172.16.0.0/12,
		# quando a origem e localhost). So delas o Caddy aceita o
		# CF-Connecting-IP (IP real do visitante, sempre sobrescrito pela
		# Cloudflare). Os demais clientes da LAN tem outro IP e nao podem forjar.
		trusted_proxies static {$SITE_IP} 172.16.0.0/12 127.0.0.0/8
		client_ip_headers CF-Connecting-IP
	}
}

(rotas) {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Healthcheck da API exposto como /api/health (a API responde em /health).
	handle /api/health {
		rewrite * /health
		reverse_proxy api:8080
	}

	# X-Forwarded-For = {client_ip} (IP do cliente, ou CF-Connecting-IP vindo do
	# host): a API le o valor mais a esquerda com TRUST_PROXY_HEADERS=true e
	# nada que o cliente mande em X-Forwarded-For passa adiante. X-Real-IP nao
	# e gerado pelo Caddy: remove o que vier do cliente.
	handle /api/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {client_ip}
			header_up -X-Real-IP
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up -X-Real-IP
		}
	}

	log {
		output stdout
		format console
	}
}

https://localhost, https://127.0.0.1, https://{$SITE_HOST}, https://{$SITE_IP} {
	tls internal
	import rotas
}

https:// {
	tls internal
	import rotas
}
