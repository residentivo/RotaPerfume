# Modelo do .env de PRODUCAO da API (deploy/docker-compose.yml -> env_file).
#
# NAO versionar o arquivo preenchido. No Jenkins, cadastre o arquivo completo
# como credencial "Secret file" com id  rotaperfumes-api-env ; o pipeline o
# grava em deploy/api.env (modo 600) so durante o deploy e apaga no final.
#
# Sintaxe (docker compose env_file): CHAVE=valor, uma por linha, sem "export".
# O compose interpola ${...}/$ em valores sem aspas: se um segredo tiver "$",
# coloque o valor entre aspas SIMPLES (ex. SMTP_PASSWORD='a$b').

# ---------------------------------------------------------------------------
# Banco (MariaDB do HOST do servidor, fora do Docker)
# ---------------------------------------------------------------------------
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=rotaperfumes
# Usuario criado por deploy/mariadb-setup.sql (apenas SELECT/INSERT/UPDATE/DELETE).
DB_USUARIO=rotaperfumes_app
DB_SENHA=

# ---------------------------------------------------------------------------
# JWT - gere com:  openssl rand -base64 48
# ---------------------------------------------------------------------------
# JWT_SECRET: obrigatório, mínimo 32 bytes (SEC-18); a API não sobe sem ele.
JWT_SECRET=
JWT_ISSUER=rotaperfumes
JWT_TTL=24h

# Pepper das senhas (SEC-13): obrigatório, >= 32 bytes, gere com
# `openssl rand -base64 48`. Use um valor próprio de produção e NUNCA o troque
# depois (as senhas argon2id deixam de bater). Para levar o dump local com
# hashes argon2id, o pepper precisa ser o mesmo do .env que os gerou.
PASSWORD_PEPPER=
ARGON2_MEMORIA_KIB=65536
ARGON2_ITERACOES=3
ARGON2_PARALELISMO=2

# ---------------------------------------------------------------------------
# Proxy / origem publica
# ---------------------------------------------------------------------------
# A API fica atras do Caddy, que SOBRESCREVE X-Forwarded-For (ignora o valor
# vindo do cliente). Com true a API usa o item mais a direita do
# X-Forwarded-For (o IP real do cliente) no rate-limit; X-Real-IP e ignorado
# (SEC-20). A API nao publica porta no host: so o Caddy a alcanca.
TRUST_PROXY_HEADERS=true
# Atributo Secure dos cookies de sessao (SEC-21). Padrao true; em producao
# (HTTPS pelo Caddy) mantenha true. Nunca use false fora de dev em HTTP.
COOKIE_SECURE=true
# Mesma origem (frontend e API no mesmo host:porta), CORS e dispensavel, mas
# deixe as origens publicas explicitas (hostname e IP), separadas por virgula.
# SEC-17: "*" e "null" sao recusados (a API NAO SOBE): o CORS responde com
# Allow-Credentials e um curinga liberaria os cookies de sessao para qualquer
# site. Confira o Secret file do Jenkins antes do deploy.
CORS_ALLOWED_ORIGINS=https://ivo-inspiron-15-3530:8443,https://192.168.168.106:8443

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
VERBOSE=false
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# SMTP (vazio = emails apenas no log)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# TLS do SMTP (MAIL-01; detalhes no .env.example da raiz).
# SMTP_TLS_MODE: implicit|starttls (vazio = 465 → implicit, demais → starttls).
# SMTP_TLS_SERVER_NAME: nome do certificado quando SMTP_HOST é IP (vazio = host).
# SMTP_TLS_CA_FILE: PEM extra a confiar. O container da API é read_only e sem
# volumes: para usar, monte o arquivo no docker-compose (ex. ./smtp-ca.pem:
# /etc/rotaperfumes/smtp-ca.pem:ro) e aponte para o caminho DENTRO do container.
SMTP_TLS_MODE=
SMTP_TLS_SERVER_NAME=
SMTP_TLS_CA_FILE=

SECURITY_ALERT_EMAILS=

# ---------------------------------------------------------------------------
# Refresh tokens
# ---------------------------------------------------------------------------
REFRESH_REUSE_SUPPRESS_WINDOW=30m
REFRESH_CLEANUP_INTERVAL=6h
REFRESH_TOKEN_RETENCAO=720h

# ---------------------------------------------------------------------------
# Imagens de produto (IMG-01). Volume nomeado produto_imagens montado neste
# caminho (deploy/docker-compose.yml, que também define a variável). O
# container é read_only: o diretório precisa ser o do volume. Vazio impede a
# subida.
# ---------------------------------------------------------------------------
PRODUTO_IMAGENS_DIR=/data/produtos-imagens

# ---------------------------------------------------------------------------
# Cloudflare Turnstile - chave SECRETA (a site key publica vai como parametro
# TURNSTILE_SITE_KEY do Jenkins). O hostname de acesso precisa estar
# cadastrado no site do Turnstile (ou usar as chaves de teste da Cloudflare).
#
# TURNSTILE_HOSTNAMES (SEC-19): hostnames de acesso ao frontend aceitos na
# resposta do Cloudflare, separados por virgula, sem esquema, porta, caminho
# nem curinga (ex.: ivo-inspiron-15-3530,192.168.168.106). Vazia = usa os
# hostnames de CORS_ALLOWED_ORIGINS (o setup-servidor.sh ja grava o hostname
# e o IP ali). Valor invalido impede a subida. Com a secret de teste da
# Cloudflare, hostname e action do token NAO sao conferidos.
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
